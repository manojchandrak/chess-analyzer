# Copy to .env.local and fill in (see docs/forum-setup.md). Both values are public; never use the service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to 1 to run the forum against an in-memory demo backend (no Supabase project needed).
# VITE_FORUM_MOCK=1

# Optional: a Google Analytics 4 Measurement ID (looks like G-ABC123XYZ). Without it analytics never loads.
# VITE_GA_MEASUREMENT_ID=
