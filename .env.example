# Copy to .env.local and fill in (see docs/forum-setup.md). Both values are public; never use the service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to 1 to run the forum against an in-memory demo backend (no Supabase project needed).
# VITE_FORUM_MOCK=1

# Optional: the site's origin for canonical links and the sitemap in the static legend/opening pages, e.g. https://example.com
# (set it as the SITE_URL Actions variable; it defaults to the GitHub Pages address).
# SITE_URL=

# Optional: a Google Analytics 4 Measurement ID (looks like G-ABC123XYZ). Without it analytics never loads.
# VITE_GA_MEASUREMENT_ID=

# Optional: "1" shows "Continue with Lichess" on the login page. Set it after deploying the lichess-login Edge Function (docs/lichess-login-setup.md).
# VITE_LICHESS_LOGIN=1
